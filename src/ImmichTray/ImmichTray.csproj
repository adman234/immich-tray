<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\immich-tray.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ImmichTray</AssemblyName>
    <RootNamespace>ImmichTray</RootNamespace>
    <Product>Immich Tray</Product>
    <Company>adman234</Company>
    <Description>Shows an Immich library as a folder in Windows Explorer.</Description>
    <Version>0.0.0-dev</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- WinForms experimental dark mode API (Application.SetColorMode). -->
    <NoWarn>$(NoWarn);WFO5001</NoWarn>
    <!-- Built-in COM interop is needed for the out-of-process thumbnail server. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Native DLLs (WPF image decoding) ship next to the exe. Unpacking them to %TEMP% broke
         thumbnails when Windows cleaned up the temp folder. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\immich-tray.ico" LogicalName="immich-tray.ico" />
    <EmbeddedResource Include="Assets\immich-tray-offline.ico" LogicalName="immich-tray-offline.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImmichTray.Tests" />
  </ItemGroup>

</Project>
